<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] [txId:%X{transactionId}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="com.hitruk.gym" level="DEBUG"/>

    <springProfile name="local,dev">
        <logger name="org.hibernate.SQL" level="DEBUG"/>
    </springProfile>
</configuration>
